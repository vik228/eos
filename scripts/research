#!/usr/bin/env bash
set -euo pipefail

source "${EOS_ROOT:-$HOME/personal/eos}/scripts/lib-workspace.sh"

if [[ "${1:-}" == "--dry-run" ]]; then
  export EOS_DRY_RUN=1
fi

dir="$(resolve_dir "$EOS_RESEARCH_DIR" "$EOS_RESEARCH_ROOT")"

support_windows=(
  "workspace:zsh"
  "notes:zsh"
  "python:python3"
  "claude:claude-personal; exec zsh"
  "codex:codex-personal; exec zsh"
  "opencode:opencode-personal; exec zsh"
  "antigravity:antigravity-full; exec zsh"
  "shell:zsh"
)

# Keep persistent support tools in tmux, but run the notebook editor directly
# in WezTerm so Molten can display plots in a stable dedicated image pane.
if [[ -n "${WEZTERM_PANE:-}" && -z "${TMUX:-}" && "${EOS_RESEARCH_TMUX:-0}" != "1" ]]; then
  if [[ "${EOS_DRY_RUN:-0}" == "1" ]]; then
    echo "editor=wezterm-direct:nvim \"$dir\""
    run_workspace "research" "$dir" "${support_windows[@]}"
    exit 0
  fi

  EOS_NO_ATTACH=1 run_workspace "research" "$dir" "${support_windows[@]}"
  editor_pane="$(wezterm cli spawn --cwd "$dir" -- nvim "$dir")"
  wezterm cli activate-pane --pane-id "$editor_pane"

  (
    while tmux has-session -t research 2>/dev/null; do
      sleep 1
    done
    wezterm cli kill-pane --pane-id "$editor_pane" 2>/dev/null || true
  ) &
  watcher_pid=$!
  trap 'kill $watcher_pid 2>/dev/null || true' EXIT

  tmux attach -t research
  wezterm cli kill-pane --pane-id "$editor_pane" 2>/dev/null || true
  exit 0
fi

run_workspace "research" "$dir" \
  "editor:nvim \"$dir\"" \
  "${support_windows[@]:1}"
