#!/usr/bin/env bash
set -euo pipefail
ROOT="${EOS_ROOT:-$HOME/personal/eos}"
source "$ROOT/scripts/lib-eos-config.sh"
exec env EOS_CAPTURE_PROFILE=work EOS_CAPTURE_AGENT=codex \
  EOS_CAPTURE_KB_ROOT="$EOS_WORK_KNOWLEDGE_ROOT" \
  EOS_CAPTURE_WORKSPACE_ROOT="$EOS_BACKEND_DIR" \
  EOS_CAPTURE_PROJECT_SLUG="$EOS_WORK_PROJECT_SLUG" \
  "$ROOT/scripts/eos-kb-capture" "$@"
