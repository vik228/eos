#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" != "--dry-run" && "${1:-}" != "--eos-adherence-prompt" ]]; then
  echo "Error: OpenCode usage is restricted in the work profile." >&2
  exit 1
fi

ROOT="${EOS_ROOT:-$HOME/personal/eos}"
source "$ROOT/scripts/lib-agent-session.sh"
cwd="${EOS_AGENT_CWD:-$PWD}"
kb="${EOS_WORK_KNOWLEDGE_ROOT:-$HOME/work/knowledge}"
bin="${EOS_AGENT_BIN:-${OPENCODE_BIN:-$HOME/personal/eos/bin/opencode}}"
mode="${OPENCODE_PERMISSION_MODE:-${CLAUDE_PERMISSION_MODE:-auto}}"
args=()
if [[ "$mode" == "auto" ]]; then
  args+=("--auto")
fi
cmd=(env "OPENCODE_CONFIG_DIR=${OPENCODE_CONFIG_DIR:-$HOME/.opencode-work}" "$bin" "${args[@]}")
agent_session_run --agent opencode --profile work --cwd "$cwd" --kb "$kb" -- "${cmd[@]}" "$@"
