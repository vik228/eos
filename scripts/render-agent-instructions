#!/usr/bin/env bash
set -euo pipefail

ROOT="${EOS_ROOT:-$HOME/personal/eos}"
source "$ROOT/scripts/lib-eos-config.sh"
AGENT_DIR="$ROOT/configs/agents"
OUTPUT_DIR="${EOS_RENDER_OUTPUT_DIR:-$AGENT_DIR}"
CRITICAL="$AGENT_DIR/fragments/critical-rules.md"
GLOBAL="$AGENT_DIR/fragments/global-context.md"
COMMON="$AGENT_DIR/common-knowledge.md"

sha256() { shasum -a 256 "$1" | awk '{print $1}'; }

# Skills are discovered from the skills directory, not hardcoded, so adding one
# is a single filesystem change. Sorted for deterministic render output.
installed_skills() {
  find "$AGENT_DIR/skills" -mindepth 2 -maxdepth 2 -name SKILL.md -print \
    | LC_ALL=C sort
}

render_installed_skills() {
  local skill path description
  while IFS= read -r skill; do
    path="${skill#"$AGENT_DIR/"}"
    description="$(sed -n 's/^description: //p' "$skill" | head -1)"
    [[ -n "$description" ]] || {
      echo "missing skill description: $skill" >&2
      return 1
    }
    printf -- '- `%s`: %s\n' "configs/agents/$path" "$description"
  done < <(installed_skills)
}

render() {
  local role="$1" output="$2"
  local critical_hash global_hash common_hash
  critical_hash="$(sha256 "$CRITICAL")"
  global_hash="$(sha256 "$GLOBAL")"
  common_hash="$(sha256 "$COMMON")"
  {
    printf '%s\n' '<!-- generated by scripts/render-agent-instructions; do not edit -->'
    printf 'source: fragments/critical-rules.md sha256:%s\n' "$critical_hash"
    printf 'source: fragments/global-context.md sha256:%s\n' "$global_hash"
    printf 'source: common-knowledge.md sha256:%s\n\n' "$common_hash"
    printf '# %s Global Instructions\n\n' "$role"
    cat "$CRITICAL"
    printf '\n'
    cat "$GLOBAL"
    printf '\n## Installed Workflows\n\n'
    render_installed_skills
    printf '\n'
    cat "$COMMON"
    if [[ "$OUTPUT_DIR" != "$AGENT_DIR" && -s "$EOS_LOCAL_AGENT_CONTEXT" ]]; then
      printf '\n# Local User Context\n\n'
      cat "$EOS_LOCAL_AGENT_CONTEXT"
    fi
  } > "$output.tmp.$$"
  mv "$output.tmp.$$" "$output"
}

for required in "$CRITICAL" "$GLOBAL" "$COMMON"; do
  [[ -f "$required" ]] || { echo "missing canonical policy source: $required" >&2; exit 1; }
done

if [[ "${1:-}" == "--check" ]]; then
  rendered_dir="$(mktemp -d)"
  trap 'rm -rf "$rendered_dir"' EXIT
  render Codex "$rendered_dir/AGENTS.md"
  render Claude "$rendered_dir/CLAUDE.md"
  render Gemini "$rendered_dir/GEMINI.md"
  for adapter in AGENTS.md CLAUDE.md GEMINI.md; do
    cmp -s "$rendered_dir/$adapter" "$AGENT_DIR/$adapter" || {
      echo "generated agent adapter drift detected: $adapter" >&2
      exit 1
    }
  done
else
  mkdir -p "$OUTPUT_DIR"
  render Codex "$OUTPUT_DIR/AGENTS.md"
  render Claude "$OUTPUT_DIR/CLAUDE.md"
  render Gemini "$OUTPUT_DIR/GEMINI.md"
fi
echo "agent instructions rendered"
