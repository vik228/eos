#!/usr/bin/env python3
"""Remove repeated unchecked proposal blocks from personal KB queues."""

from __future__ import annotations

import os
import re
import sys
import tempfile
from pathlib import Path


OPEN_ITEM = re.compile(r"^- \[ \]\s*")
ANY_ITEM = re.compile(r"^- \[[ xX]\]\s*")
SECTION = re.compile(r"^##\s+")


def proposal_key(block: list[str]) -> str:
    text = OPEN_ITEM.sub("", block[0], count=1) + "".join(block[1:])
    return " ".join(text.split()).casefold()


def dedupe_queue(path: Path) -> int:
    lines = path.read_text(encoding="utf-8").splitlines(keepends=True)
    output: list[str] = []
    seen: set[str] = set()
    removed = 0
    index = 0

    while index < len(lines):
        if not OPEN_ITEM.match(lines[index]):
            output.append(lines[index])
            index += 1
            continue

        end = index + 1
        while end < len(lines):
            if ANY_ITEM.match(lines[end]) or SECTION.match(lines[end]):
                break
            end += 1
        block = lines[index:end]
        key = proposal_key(block)
        if key and key in seen:
            removed += 1
        else:
            seen.add(key)
            output.extend(block)
        index = end

    if removed:
        mode = path.stat().st_mode
        with tempfile.NamedTemporaryFile(
            "w", encoding="utf-8", dir=path.parent, delete=False
        ) as handle:
            handle.writelines(output)
            temporary = Path(handle.name)
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    return removed


def main() -> int:
    root = Path(sys.argv[1] if len(sys.argv) > 1 else Path.home() / "personal/knowledge")
    removed = 0
    for parent in (root / "projects", root / "areas"):
        if parent.is_dir():
            for queue in sorted(parent.rglob("_pending-kb-updates.md")):
                removed += dedupe_queue(queue)
    print(f"removed {removed} duplicate pending proposal(s)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
