#!/usr/bin/env bash
set -euo pipefail
ROOT="${EOS_ROOT:-$HOME/personal/eos}"
source "$ROOT/scripts/lib-agent-session.sh"
cwd="${EOS_AGENT_CWD:-$PWD}"
kb="${EOS_WORK_KNOWLEDGE_ROOT:-$HOME/work/knowledge}"
bin="${EOS_AGENT_BIN:-${CLAUDE_BIN:-$HOME/personal/eos/bin/claude}}"
cmd=(env "CLAUDE_CONFIG_DIR=${CLAUDE_CONFIG_DIR:-$HOME/.claude-work}" "$bin" --permission-mode "${CLAUDE_PERMISSION_MODE:-auto}" --append-system-prompt-file "$ROOT/configs/agents/fragments/critical-rules.md")
agent_session_run --agent claude --profile work --cwd "$cwd" --kb "$kb" -- "${cmd[@]}" "$@"
