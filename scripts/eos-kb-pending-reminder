#!/usr/bin/env bash
set -euo pipefail

mode="${1:---text}"
root="${EOS_CAPTURE_KB_ROOT:-${EOS_KB_ROOT:-}}"
[[ -n "$root" ]] || { echo "EOS_CAPTURE_KB_ROOT or EOS_KB_ROOT is required" >&2; exit 2; }

profile="${EOS_CAPTURE_PROFILE:-}"
if [[ -z "$profile" ]]; then
  case "$root" in
    "${EOS_WORK_KNOWLEDGE_ROOT:-$HOME/work/knowledge}") profile=work ;;
    *) profile=personal ;;
  esac
fi

queues=()
while IFS= read -r queue; do queues+=("$queue"); done < <(
  find "$root" -type f -name '_pending-kb-updates.md' 2>/dev/null | LC_ALL=C sort
)

total=0
details=()
for queue in "${queues[@]}"; do
  count="$(grep -c '^- \[ \]' "$queue" 2>/dev/null || true)"
  count="${count:-0}"
  if (( count > 0 )); then
    total=$((total + count))
    details+=("${queue#"$root"/}: $count")
  fi
done

(( total > 0 )) || exit 0
message="$total pending $profile KB proposal(s) across ${#details[@]} queue(s) await review"
detail_text="$(printf '%s\n' "${details[@]}")"
context="Review only the $profile KB queues listed here. Apply stable changes only through kb propose, kb review, and kb promote."

case "$mode" in
  --text) printf '[%s KB]\n%s\n%s\n' "$profile" "$message" "$detail_text" ;;
  --json)
    jq -cn --arg m "$message" --arg d "$detail_text" --arg c "$context" \
      '{systemMessage:($m + "\n" + $d), additional_context:$c, hookSpecificOutput:{hookEventName:"SessionStart", additionalContext:($m + "\n" + $d + "\n" + $c)}}'
    ;;
  *) echo "usage: eos-kb-pending-reminder [--text|--json]" >&2; exit 2 ;;
esac
