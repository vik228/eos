#!/usr/bin/env bash
set -euo pipefail

source "${EOS_ROOT:-$HOME/personal/eos}/scripts/lib-workspace.sh"

if [[ "${1:-}" == "--dry-run" ]]; then
  export EOS_DRY_RUN=1
fi

dir="$(resolve_dir "$EOS_PERSONAL_ROOT")"
run_workspace "agents" "$dir" \
  "claude-work:claude-work; exec zsh" \
  "claude-personal:claude-personal; exec zsh" \
  "codex-work:codex-work; exec zsh" \
  "codex-personal:codex-personal; exec zsh" \
  "opencode-work:opencode-work; exec zsh" \
  "opencode-personal:opencode-personal; exec zsh" \
  "antigravity:antigravity-full; exec zsh" \
  "shell:zsh"
