#!/usr/bin/env bash
# One-line-per-fact status for the Colab link: session, forward, server, usage.
set -euo pipefail

ROOT="${EOS_ROOT:-$HOME/personal/eos}"
source "$ROOT/scripts/lib-eos-config.sh"
SESSION="${EOS_COLAB_SESSION:-eos}"
LOCAL_PORT="${EOS_COLAB_LOCAL_PORT:-18989}"
STATE_DIR="${EOS_STATE_DIR:-$HOME/.local/state/eos}/colab"
STATE="$STATE_DIR/forward.env"

COLAB_BIN="${EOS_COLAB_BIN:-$ROOT/scripts/colab}"

sessions_out="$("$COLAB_BIN" sessions 2>/dev/null || true)"
if [[ -n "$sessions_out" ]] && printf '%s\n' "$sessions_out" | awk -v name="$SESSION" '
  { for (i = 1; i <= NF; i++) if ($i == name || $i == "[" name "]") { found = 1 } }
  END { exit(!found) }'; then
  session="active"
else
  session="none"
fi

forward="down"
server="unknown"
if [[ -f "$STATE" ]]; then
  # shellcheck source=/dev/null
  source "$STATE"
  if [[ -n "${STATE_PID:-}" ]] && kill -0 "${STATE_PID}" 2>/dev/null; then
    forward="up"
    if [[ -n "${STATE_TOKEN:-}" ]] && curl -fsS -o /dev/null --max-time 5 \
      "http://127.0.0.1:${STATE_LOCAL_PORT:-$LOCAL_PORT}/api/kernels?token=${STATE_TOKEN}" 2>/dev/null; then
      server="ready"
    else
      server="unreachable"
    fi
  fi
fi

usage="$("$COLAB_BIN" usage 2>/dev/null | tr '\n' '; ' || true)"

printf 'session=%s\nforward=%s\nserver=%s\nusage=%s\n' "$session" "$forward" "$server" "${usage:-unknown}"
[[ "$session" == "active" ]] || exit 1
