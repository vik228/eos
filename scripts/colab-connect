#!/usr/bin/env bash
# Ensure a Colab runtime with a Jupyter server and a local port forward.
# Prints KEY=value lines (SESSION, LOCAL_PORT, TOKEN, CREATED, SERVER) for
# nvim and scripts. Idempotent: reuses a live forward when one exists.
#
#   colab-connect [--create]     # --create allows making a new paid runtime
#
# Without --create, a missing session exits 3 so callers fall back locally.
# A second concurrent connect exits 4. Token checks hit the authenticated
# /api/kernels endpoint: the /api root answers without a token.
set -euo pipefail

ROOT="${EOS_ROOT:-$HOME/personal/eos}"
source "$ROOT/scripts/lib-eos-config.sh"
SESSION="${EOS_COLAB_SESSION:-eos}"
GPU="${EOS_COLAB_GPU:-T4}"
HIGH_MEM="${EOS_COLAB_HIGH_MEM:-0}"
LOCAL_PORT="${EOS_COLAB_LOCAL_PORT:-18989}"
REMOTE_PORT="${EOS_COLAB_REMOTE_PORT:-18888}"
STATE_DIR="${EOS_STATE_DIR:-$HOME/.local/state/eos}/colab"
STATE="$STATE_DIR/forward.env"
LOCKDIR="$STATE_DIR/connect.lock"
CREATE=0

for arg in "$@"; do
  case "$arg" in
    --create) CREATE=1 ;;
    -h|--help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "colab-connect: unknown option: $arg" >&2; exit 2 ;;
  esac
done

COLAB_BIN="${EOS_COLAB_BIN:-$ROOT/scripts/colab}"
SSH="${EOS_SSH_BIN:-ssh}"

die() { echo "colab-connect: $*" >&2; exit 1; }

colab_key() {
  if [[ -n "${EOS_COLAB_IDENTITY:-}" && -f "${EOS_COLAB_IDENTITY:-}" ]]; then
    printf '%s\n' "$EOS_COLAB_IDENTITY"
    return 0
  fi
  local candidate
  for candidate in "$HOME/.ssh/id_ed25519" "$HOME/.ssh/id_ecdsa" "$HOME/.ssh/eos_colab_ed25519"; do
    if [[ -f "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

IDENTITY="$(colab_key)" || die "no ssh key found (run scripts/setup-colab)"
PROXY="ProxyCommand $COLAB_BIN ssh --proxy-mode -s $SESSION -i $IDENTITY"

# The session list is captured before matching: exact field match (so "eos"
# never matches "eos2"), and no SIGPIPE against the CLI.
session_active() {
  local out
  out="$("$COLAB_BIN" sessions 2>/dev/null || true)"
  [[ -n "$out" ]] || return 1
  printf '%s\n' "$out" | awk -v name="$SESSION" '
    { for (i = 1; i <= NF; i++) if ($i == name || $i == "[" name "]") { found = 1 } }
    END { exit(!found) }'
}

api_ok() {
  curl -fsS -o /dev/null --max-time 5 "$1" 2>/dev/null || return 1
}

forward_alive() {
  local pid="$1" port="$2" token="$3"
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null || return 1
  api_ok "http://127.0.0.1:$port/api/kernels?token=$token"
}

kill_forward() {
  local pid="$1" spec="$2" cmdline
  [[ -n "$pid" ]] || return 0
  cmdline="$(ps -o command= -p "$pid" 2>/dev/null || true)"
  if [[ -n "$cmdline" && "$cmdline" == *"$spec"* ]]; then
    kill "$pid" 2>/dev/null || true
  fi
}

ssh_run() {
  "$SSH" -o "$PROXY" \
    -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
    -o IdentitiesOnly=yes -i "$IDENTITY" \
    -o BatchMode=yes -o ConnectTimeout=30 "root@colab-session" "$@"
}

mkdir -p "$STATE_DIR"
chmod 700 "$STATE_DIR"
LOCK_MINE=0
take_lock() {
  mkdir "$LOCKDIR" 2>/dev/null && { LOCK_MINE=1; return 0; }
  return 1
}
if ! take_lock; then
  if [[ -n "$(find "$LOCKDIR" -mmin +10 2>/dev/null || true)" ]]; then
    rmdir "$LOCKDIR" 2>/dev/null || true
    take_lock || { echo "colab-connect: another connect is in progress" >&2; exit 4; }
  else
    echo "colab-connect: another connect is in progress" >&2
    exit 4
  fi
fi
trap '[[ "${LOCK_MINE:-0}" == 1 ]] && rmdir "$LOCKDIR" 2>/dev/null || true' EXIT

# Reuse a live forward when the state file describes one. The created flag is
# reported as stored: losing it would leave a paid runtime unstoppable.
if [[ -f "$STATE" ]]; then
  # shellcheck source=/dev/null
  source "$STATE"
  if [[ "${STATE_SESSION:-}" == "$SESSION" && "${STATE_LOCAL_PORT:-}" == "$LOCAL_PORT" ]] \
    && forward_alive "${STATE_PID:-}" "$LOCAL_PORT" "${STATE_TOKEN:-}"; then
    printf 'SESSION=%s\nLOCAL_PORT=%s\nTOKEN=%s\nCREATED=%s\nSERVER=%s\n' \
      "$SESSION" "$LOCAL_PORT" "$STATE_TOKEN" "${STATE_CREATED:-0}" "${STATE_SERVER:-notebook}"
    exit 0
  fi
  kill_forward "${STATE_PID:-}" "-L $LOCAL_PORT:127.0.0.1:$REMOTE_PORT"
fi

PREV_CREATED=0
if [[ -f "$STATE" ]]; then
  # shellcheck source=/dev/null
  source "$STATE"
  [[ "${STATE_SESSION:-}" == "$SESSION" && "${STATE_CREATED:-0}" == 1 ]] && PREV_CREATED=1
fi

CREATED=0
if ! session_active; then
  [[ "$CREATE" == 1 ]] || { echo "colab-connect: no active session '$SESSION' (use --create to make one)" >&2; exit 3; }
  echo "colab: creating session '$SESSION'${GPU:+ ($GPU)} (this takes minutes)..." >&2
  create_args=(new -s "$SESSION")
  [[ -n "$GPU" ]] && create_args+=(--gpu "$GPU")
  [[ "$HIGH_MEM" == 1 ]] && create_args+=(--high-mem)
  "$COLAB_BIN" "${create_args[@]}" >/dev/null || die "could not create session '$SESSION'"
  CREATED=1
else
  echo "colab: session '$SESSION' active" >&2
fi
[[ "$PREV_CREATED" == 1 ]] && CREATED=1

TOKEN="$(openssl rand -hex 16)"

# A half-dead forward still holds Colab's single bridge slot and would get
# every ssh below rejected: drop it before touching the runtime.
if [[ -f "$STATE" ]]; then
  # shellcheck source=/dev/null
  source "$STATE"
  kill_forward "${STATE_PID:-}" "-L $LOCAL_PORT:127.0.0.1:$REMOTE_PORT"
fi
while IFS= read -r pid; do
  kill_forward "$pid" "-L $LOCAL_PORT:127.0.0.1:$REMOTE_PORT"
done < <(pgrep -f -- "-L $LOCAL_PORT:127.0.0.1:$REMOTE_PORT" || true)

# Restart the remote server so the token is always fresh and known. The
# bracket pattern keeps pkill from matching its own shell on Linux procps.
echo "colab: starting remote jupyter (about 30 seconds)..." >&2
ssh_run 'pkill -f "[j]upyter.*--port='"$REMOTE_PORT"'" 2>/dev/null; true'
ssh_run "nohup jupyter notebook --no-browser --allow-root --port=$REMOTE_PORT --ip=127.0.0.1 --NotebookApp.token=$TOKEN >/tmp/eos-jnb.log 2>&1 & sleep 2" >/dev/null

ready=0
for _ in $(seq 1 10); do
  if ssh_run "curl -fsS -o /dev/null --max-time 5 'http://127.0.0.1:$REMOTE_PORT/api/kernels?token=$TOKEN'" 2>/dev/null; then
    ready=1
    break
  fi
  sleep 5
done
[[ "$ready" == 1 ]] || die "remote jupyter did not start (see /tmp/eos-jnb.log on the runtime)"

echo "colab: opening tunnel..." >&2
"$SSH" -o "$PROXY" \
  -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
  -o IdentitiesOnly=yes -i "$IDENTITY" \
  -o BatchMode=yes -o ConnectTimeout=30 -o ExitOnForwardFailure=yes \
  -N -f -L "$LOCAL_PORT:127.0.0.1:$REMOTE_PORT" "root@colab-session" \
  </dev/null >/dev/null 2>&1 || die "could not establish port forward"
FWD_PID="$(pgrep -f -- "-L $LOCAL_PORT:127.0.0.1:$REMOTE_PORT" | head -n 1 || true)"
[[ -n "$FWD_PID" ]] || die "forward started but pid not found"

echo "colab: verifying link..." >&2
ready=0
for _ in $(seq 1 6); do
  if api_ok "http://127.0.0.1:$LOCAL_PORT/api/kernels?token=$TOKEN"; then
    ready=1
    break
  fi
  sleep 5
done
if [[ "$ready" != 1 ]]; then
  kill "$FWD_PID" 2>/dev/null || true
  die "forward established but localhost:$LOCAL_PORT never answered"
fi

umask 077
cat >"$STATE" <<EOF
STATE_SESSION=$SESSION
STATE_LOCAL_PORT=$LOCAL_PORT
STATE_REMOTE_PORT=$REMOTE_PORT
STATE_TOKEN=$TOKEN
STATE_PID=$FWD_PID
STATE_CREATED=$CREATED
STATE_SERVER=notebook
EOF
chmod 600 "$STATE"

printf 'SESSION=%s\nLOCAL_PORT=%s\nTOKEN=%s\nCREATED=%s\nSERVER=%s\n' \
  "$SESSION" "$LOCAL_PORT" "$TOKEN" "$CREATED" "notebook"
