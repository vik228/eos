#!/usr/bin/env bash
set -euo pipefail

source "${EOS_ROOT:-$HOME/personal/eos}/scripts/lib-workspace.sh"

if [[ "${1:-}" == "--dry-run" ]]; then
  export EOS_DRY_RUN=1
fi

dir="$(resolve_dir "$EOS_RESEARCH_ROOT")"
run_workspace "paper" "$dir" \
  "editor:nvim" \
  "notes:zsh" \
  "python:python3" \
  "claude:claude-personal; exec zsh" \
  "experiments:zsh" \
  "shell:zsh"
