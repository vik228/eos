#!/usr/bin/env bash
# Guard for plain `codex`: inside the work tree it must run on the work account.
# Work delegation uses `codex-work` (CODEX_HOME=~/.codex-work). A plain `codex`
# launched for a work directory would silently use the personal account and its
# quota. Set EOS_ALLOW_PERSONAL_AGENT_IN_WORK=1 for a deliberate exception.
set -euo pipefail

self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/$(basename "${BASH_SOURCE[0]}")"
work_root="${EOS_WORK_ROOT:-$HOME/work}"
work_home="${EOS_CODEX_WORK_HOME:-$HOME/.codex-work}"

resolve_dir() {
  (cd "$1" 2>/dev/null && pwd -P) || printf '%s' "$1"
}

# The directory codex will work in: the --cd/-C argument when given, else $PWD.
target="$PWD"
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  case "${args[$i]}" in
    --cd|-C) target="${args[$((i + 1))]:-$target}" ;;
    --cd=*) target="${args[$i]#--cd=}" ;;
  esac
done
target="$(resolve_dir "$target")"
work_root="$(resolve_dir "$work_root")"

in_work=0
[[ "$target" == "$work_root" || "$target" == "$work_root/"* ]] && in_work=1

if [[ "$in_work" == 1 && "${EOS_ALLOW_PERSONAL_AGENT_IN_WORK:-0}" != 1 ]]; then
  codex_home="${CODEX_HOME:-$HOME/.codex}"
  if [[ "$(resolve_dir "$codex_home")" != "$(resolve_dir "$work_home")" ]]; then
    echo "Refusing plain codex in $target: work directories must use codex-work (CODEX_HOME=$work_home)." >&2
    echo "Run codex-work instead, or set EOS_ALLOW_PERSONAL_AGENT_IN_WORK=1 for a deliberate exception." >&2
    exit 64
  fi
fi

# Select the newest installed CLI explicitly so the result does not depend on
# PATH order. Login shells reorder PATH via path_helper (/etc/zprofile),
# putting /usr/local/bin ahead of the guard and NVM; interactive shells keep
# the guard first. Comparing versions makes every launcher agree on one binary.
# Candidates without a parseable version stay eligible but never outrank a
# parsed one; with no parsed version anywhere the first candidate wins.
codex_version() {
  local out ver
  out="$("$1" --version 2>/dev/null | head -n 1 || true)"
  ver="$(printf '%s\n' "$out" | grep -oE '[0-9]+(\.[0-9]+)+' | head -n 1 || true)"
  printf '%s' "$ver"
}

version_newer() {
  local first="$1" second="$2"
  if [[ -n "$first" && -z "$second" ]]; then
    return 0
  fi
  if [[ -z "$first" ]]; then
    return 1
  fi
  local IFS=.
  local -a first_parts=() second_parts=()
  read -ra first_parts <<<"$first"
  read -ra second_parts <<<"$second"
  local i first_num second_num
  for ((i = 0; i < ${#first_parts[@]} || i < ${#second_parts[@]}; i+=1)); do
    first_num="${first_parts[i]:-0}"
    second_num="${second_parts[i]:-0}"
    if ((10#$first_num > 10#$second_num)); then
      return 0
    fi
    if ((10#$first_num < 10#$second_num)); then
      return 1
    fi
  done
  return 1
}

best=""
best_version=""
IFS=: read -r -a dirs <<<"$PATH"
for dir in "${dirs[@]}"; do
  candidate="$dir/codex"
  [[ -x "$candidate" && ! -d "$candidate" ]] || continue
  real="$(cd "$(dirname "$candidate")" && pwd -P)/codex"
  [[ "$real" == "$self" ]] && continue
  if [[ -z "$best" ]]; then
    best="$candidate"
    best_version="$(codex_version "$candidate")"
    continue
  fi
  candidate_version="$(codex_version "$candidate")"
  if version_newer "$candidate_version" "$best_version"; then
    best="$candidate"
    best_version="$candidate_version"
  fi
done
if [[ -z "$best" ]]; then
  echo "codex guard: no real codex binary found on PATH" >&2
  exit 127
fi
exec "$best" "$@"
