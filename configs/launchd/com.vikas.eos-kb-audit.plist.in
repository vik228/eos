<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.vikas.eos-kb-audit</string>
  <key>ProgramArguments</key>
  <array><string>/bin/zsh</string><string>__RUNNER__</string></array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>21600</integer>
  <key>StandardOutPath</key><string>__LOG_ROOT__/audit.log</string>
  <key>StandardErrorPath</key><string>__LOG_ROOT__/audit.error.log</string>
</dict>
</plist>
