{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eos.dev/schemas/registry-v1.json",
  "title": "EOS workspace registry",
  "type": "object",
  "required": ["workspaces"],
  "properties": {
    "workspaces": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["kb", "project"],
        "properties": {
          "kb": {"type": "string", "minLength": 1},
          "project": {"type": "string", "minLength": 1},
          "coverage": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["paths", "concepts"],
              "properties": {
                "paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                "concepts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                "ignore": {"type": "array", "items": {"type": "string", "minLength": 1}}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
